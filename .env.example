# Identifiant client confirmé par EVKX (celui de ton mail d'inscription)
EVKX_CLIENT_ID=calculateur-recharge-ev

# Clé PRIVÉE générée par `npm run keys` (contenu du fichier keys/<id>.key).
# Dans le tableau de bord Vercel, colle le PEM tel quel (multi-lignes).
# Dans un .env local, tout sur une ligne avec des \n :
# EVKX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
EVKX_PRIVATE_KEY=

# Optionnel (par défaut https://evkx.net)
# EVKX_BASE_URL=https://evkx.net
